{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Broker": {
    "Storage": "Memory",
    "ConnectionString": null,
    "AdminKey": null,
    "DataDirectory": "../../data",
    "ClientIpHeader": null,
    "ExpirySweepSeconds": 30
  },
  "Exchange": {
    "AckLatencyMs": 20,
    "AckJitterMs": 30,
    "AlwaysOpen": false
  },
  "MarketData": {
    "Redis": {
      "Configuration": null,
      "Stream": "market:ticks"
    }
  }
}
